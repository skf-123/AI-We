# ============================================================
#  环境变量模板
#  用法：把本文件复制一份改名为 .env ，再填入真实的值。
#       .env 已被 .gitignore 排除，绝不会被提交到仓库。
#  ⚠️ 千万不要把真实 key 写进这个模板文件里，它是要上传的！
# ============================================================

# DeepSeek API Key（必填）
# 申请地址：https://platform.deepseek.com
NUXT_DEEPSEEK_API_KEY=

# 以下三项都有默认值，一般不用改
# NUXT_DEEPSEEK_BASE_URL=https://api.deepseek.com
# NUXT_DEEPSEEK_MODEL=deepseek-flash
