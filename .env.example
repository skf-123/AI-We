# ============================================================
#  环境变量模板
#  用法：把本文件复制一份改名为 .env ，再填入真实的值。
#       .env 已被 .gitignore 排除，绝不会被提交到仓库。
#  ⚠️ 千万不要把真实 key 写进这个模板文件里，它是要上传的！
# ============================================================


# ---------- LLM 主调用：负责生成四段解释 ----------
# 当前使用 DeepSeek，申请地址：https://platform.deepseek.com
# 已经有一个 key 了 → 只填这一行就能跑
NUXT_LLM_API_KEY=

NUXT_LLM_BASE_URL=https://api.deepseek.com
NUXT_LLM_MODEL=deepseek-chat


# ---------- Embedding：负责把文字变成向量，供知识库检索 ----------
# 当前使用智谱 GLM，申请地址：https://open.bigmodel.cn
#
# ⚠️ 这是和上面【完全分开】的另一家服务，两组 key 不能互换：
#    LLM       → 生成文字（DeepSeek）
#    Embedding → 生成向量（智谱）
# 两家的向量空间不通用，拿错 key 只会得到 404 或维度错乱。
# 这个 key 缺失时，知识库检索会直接跳过（降级为纯模型回答），
# 不会拿 LLM 的 key 去顶替。
NUXT_EMBEDDING_API_KEY=

NUXT_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
NUXT_EMBEDDING_MODEL=embedding-3
NUXT_EMBEDDING_DIMENSIONS=1024


# ---------- 知识库检索行为（都有默认值，一般不用改）----------
# 关掉知识库检索（用于对比"有 RAG"和"没 RAG"的效果）：
# NUXT_RAG_ENABLED=true
# 每次检索取回几条资料：
# NUXT_RAG_TOP_K=4
# 相似度低于这个分数就不采用（0.5 是用 scripts/rag-probe.mjs 实测校准出来的）：
# NUXT_RAG_MIN_SCORE=0.5
